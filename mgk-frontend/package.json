{
  "name": "mgk-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf node_modules .next dist"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      },
      "ignoreMissing": [
        "@solana/wallet-adapter-walletconnect"
      ]
    },
    "overrides": {
      "bs58": "^5.0.0",
      "zod": "^3.23.0"
    }
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
